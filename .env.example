# --- Server ---
PORT=5001
NODE_ENV=development
CLIENT_URL=*
JWT_SECRET=change-me

# --- MongoDB (multi-tenant) ---
# Single cluster/server URI. Do NOT include a database name — the app selects
# the control DB and per-tenant DBs itself via useDb().
MONGODB_URI=mongodb://127.0.0.1:27017
# Control DB holding the `projects` tenant registry
CONTROL_DB_NAME=Universal_Control
# Fallback tenant for requests without a project code (transition period) and
# for scripts/socket auth running outside a request context
DEFAULT_PROJECT_CODE=RET5677
DEFAULT_DB_NAME=Pagariya_DB

# --- Rate limiting ---
RATE_LIMIT_SKIP_IPS=

# --- Errors ---
# Return error stacks and raw 5xx messages to API clients. Leave unset in any
# deployed environment — this is NOT inferred from NODE_ENV, because the
# deployed servers run with NODE_ENV=development.
EXPOSE_ERROR_DETAIL=false

# --- SMS ---
# The message sender name is taken per-tenant from the project registry
# (config.app_name); SMS_CLIENT_NAME is only the fallback.
SMS_BASE_URL=
SMS_USER_ID=
SMS_PASSWORD=
SMS_SENDER_ID=
SMS_CLIENT_NAME=

# Fixed-OTP escape hatch for local dev and CI. When enabled, SMS_TEST_OTP
# authenticates ANY mobile number without an SMS round trip. BOTH variables are
# required to switch it on, and it must never be enabled on a deployment that
# real customers can reach.
SMS_ALLOW_TEST_OTP=false
SMS_TEST_OTP=

# --- Razorpay (default tenant; per-tenant keys live in the project registry) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Firebase (push notifications) ---
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# --- Cloudinary (media) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
